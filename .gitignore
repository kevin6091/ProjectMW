# Visual Studio 2015의 개인 작업 환경 파일
.vs/

# 컴파일 과정에서 만들어지는 중간 파일
*.slo
*.lo
*.o
*.obj

# 컴파일 시간을 줄이려고 미리 처리해 둔 헤더 파일
*.gch
*.pch

# 컴파일된 동적 라이브러리 파일
*.so
*.dylib
*.dll

# 포트란 모듈 파일
*.mod

# 컴파일된 정적 라이브러리 파일
*.lai
*.la
*.a
*.lib

# 실행 파일
*.exe
*.out
*.app
*.ipa

# 엔진이 다시 생성할 수 있는 프로젝트와 개발 도구 파일
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# SourceArt 폴더 아래의 이미지 파일
SourceArt/**/*.png
SourceArt/**/*.tga

# 컴파일 결과로 만들어지는 바이너리 파일
Binaries/*
Plugins/**/Binaries/*

# 빌드 과정에서 만들어지는 파일
Build/*

# 빌드 설정별 PakBlacklist 파일은 예외로 포함
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Build 폴더의 아이콘 파일은 예외로 포함
!Build/**/*.ico

# 맵을 빌드하면서 만들어지는 데이터
*_BuiltData.uasset

# 에디터 실행 중 만들어지는 설정과 저장 파일
Saved/*

# 엔진이 소스를 컴파일하며 만들어지는 중간 파일
Intermediate/*
Plugins/**/Intermediate/*

# 에디터가 작업 속도를 높이려고 보관하는 임시 파일
DerivedDataCache/*

# 개인 개발 도구 설정과 자동 생성된 솔루션 파일
.idea/
*.slnx

# Assets are managed in Unity Version Control
/Content/
/.plastic/
/ignore.conf